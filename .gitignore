node_modules/
dist/
*.log
.env
.DS_Store

# Cloud sync-conflict copies (OneDrive/iCloud/Dropbox). These duplicate a real file
# under a name that embeds a PERSON and a DEVICE — "package-Jane’s MacBook Air.json"
# — so a single `git add -A` publishes an identity leak in a filename, where no
# content scan would think to look. Both apostrophe styles, since OneDrive uses the
# typographic one.
*’s *
*'s *
*conflicted copy*

# generated from a real brain during testing — never commit personal vault content
test/scenarios.json
test/scenarios-v2.json
test/stress-failures.json
test/.fixture-brain/
test/.fixture-structure/
# Any fixture/scratch dir or file a debugging session leaves behind. Named ones
# kept being added here one at a time and the next session invented a new name,
# so a `git add -A` was always one forgotten line away from committing a tree
# built out of the real vault. Glob it instead of chasing it.
test/.fixture-*/
test/.tmp-*/
test/tmp-*
test/_repro-*
test/_probe*
test/_tmp-*
test/judge/
test/gold/
test/gbrain-headtohead.md
test/v2-failures.json
test/judge2/
test/scenarios-v3.json
test/judge3/
test/judge4/
test/scenarios-v4-final.json
test/judge5/

# design prototype from Claude Design — contains vault-derived mock data, keep local
design/
*.tgz

# benchmark outputs + failure dumps generated FROM the real vault — never commit
# (they embed real note paths incl. Private/). Synthetic fixtures like
# structuring-bench.json are deliberately safe and stay tracked.
test/scenarios-casual*.json
test/*-failures.json
test/true-misses.json
test/goal5-*

# benchmark report cards + scenario sets generated from a real brain during
# testing — regenerable, and may embed personal vault content. Never commit.
test/scenarios-*.json
test/_bench-*.json
# underscore-prefixed test files are scratch by convention: probe scripts and the
# raw per-query dumps the calibration harness writes (those carry real questions
# and note paths, including Private/). The harnesses themselves stay tracked.
test/_bench15k-*
test/_calib-*
test/*-casual*.txt
test/*-casual*.err.txt
test/scenarios-v4-current.json
test/agent-tool.mjs
test/wp-3hop.mjs
test/wp-ceiling.mjs
test/wp-firerate.mjs
test/wp-judge-batch.mjs
test/wp-judge-data.mjs
test/wp-multihop.mjs
test/wp-secondhop.mjs
test/.review-pass.wf.js
