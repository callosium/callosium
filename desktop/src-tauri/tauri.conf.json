{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Callosium",
  "version": "0.1.15",
  "identifier": "com.callosium.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Callosium",
        "width": 1240,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["payload/**/*"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2NkFBQzFEMzk3OTcyODAKUldTQWNuazVIYXhxOXJVTjZHaTluU3RBYWtJaHlxZ2tHZGQ5eUgvMmFZMWhmNDRLL3dUbXExRmUK",
      "endpoints": [
        "https://github.com/callosium/callosium/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
